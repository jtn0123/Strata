# The engine's C++ / CUDA / HIP style as it is written: 4-space indent, attached braces, `T& x`, `(T) x` casts,
# short ifs and loops on one line, includes in their own order, 120 columns.  No file has been reformatted with
# it, and the hand layout differs in places: format only what you change (`git clang-format` formats the changed
# lines), not whole files.
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 120
AccessModifierOffset: -4
NamespaceIndentation: None
PointerAlignment: Left
ReferenceAlignment: Left
SpaceAfterCStyleCast: true
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Always
AllowShortFunctionsOnASingleLine: All
AllowShortLambdasOnASingleLine: All
AllowShortCaseLabelsOnASingleLine: true
AlignOperands: DontAlign
AlignEscapedNewlines: DontAlign
AlignConsecutiveMacros: false
AlignTrailingComments:
  Kind: Leave
SpacesBeforeTrailingComments: 2
SortIncludes: Never
IncludeBlocks: Preserve
IndentPPDirectives: None
FixNamespaceComments: false
ReflowComments: false
