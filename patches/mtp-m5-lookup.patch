+// Opt-in native lookup accounting. These times bound the complete CPU gather,
+// including dequantization and scheduling; they are NOT attributed SSD waits.
+static bool ggml_m5_lookup_node(const struct ggml_tensor * node) {
+    const struct ggml_tensor * src = node->src[0];
+    return node->op == GGML_OP_GET_ROWS && src &&
+        src->type == GGML_TYPE_IQ4_NL && src->ne[0] == 160 &&
+        src->ne[1] == 320001536 && src->ne[2] == 1 && src->ne[3] == 1 &&
+        src->nb[1] == 90 && node->src[1]->type == GGML_TYPE_I32 &&
+        strcmp(src->name, "per_layer_token_embd.weight") == 0;
+}
+
+static int ggml_m5_lookup_compare_u64(const void * a, const void * b) {
+    const uint64_t x = *(const uint64_t *) a, y = *(const uint64_t *) b;
+    return (x > y) - (x < y);
+}
+
+// Called by worker 0 only AFTER an already-existing node/final graph barrier.
+static void ggml_m5_lookup_emit(struct ggml_threadpool * tp, const struct ggml_tensor * node,
+        int nth, unsigned slot) {
+    int64_t begin = INT64_MAX, end = 0, sum = 0;
+    for (int i = 0; i < nth; ++i) {
+        const struct ggml_compute_state * worker = &tp->workers[i];
+        begin = MIN(begin, worker->m5_lookup_begin_us[slot]);
+        end = MAX(end, worker->m5_lookup_end_us[slot]);
+        sum += worker->m5_lookup_end_us[slot] - worker->m5_lookup_begin_us[slot];
+    }
+    const uint64_t ordinal = tp->m5_lookup_ordinal++;
+    const struct ggml_tensor * src = node->src[0];
+    const struct ggml_tensor * ids = node->src[1];
+    const int64_t nr = ggml_nelements(ids);
+    // Bounded metadata scratch; never read tensor payloads or touch lookup pages.
+    const int64_t cap = 65536;
+    const int64_t counted = MIN(nr, cap);
+    uint64_t * rows = counted ? malloc((size_t) counted * sizeof(uint64_t)) : NULL;
+    uint64_t * pages = counted ? malloc((size_t) counted * 2 * sizeof(uint64_t)) : NULL;
+    size_t n_unique = 0, n_pages = 0;
+#if defined(_WIN32)
+    SYSTEM_INFO info;
+    GetSystemInfo(&info);
+    const size_t page_size = info.dwPageSize;
+#else
+    const long page_result = sysconf(_SC_PAGESIZE);
+    const size_t page_size = page_result > 0 ? (size_t) page_result : 0;
+#endif
+    const bool metadata_ok = rows && pages && page_size;
+    if (metadata_ok) {
+        for (int64_t i = 0; i < counted; ++i) {
+            const int64_t i12 = i / (ids->ne[1] * ids->ne[0]);
+            const int64_t i11 = (i - i12 * ids->ne[1] * ids->ne[0]) / ids->ne[0];
+            const int64_t i10 = i % ids->ne[0];
+            int32_t row;
+            memcpy(&row, (const char *) ids->data + i10*ids->nb[0] + i11*ids->nb[1] + i12*ids->nb[2], sizeof(row));
+            GGML_ASSERT(row >= 0 && row < src->ne[1]);
+            rows[i] = (uint64_t) row;
+        }
+        qsort(rows, (size_t) counted, sizeof(uint64_t), ggml_m5_lookup_compare_u64);
+        for (int64_t i = 0; i < counted; ++i) {
+            if (i && rows[i] == rows[i-1]) {
+                continue;
+            }
+            ++n_unique;
+            const uintptr_t addr = (uintptr_t) src->data + rows[i] * src->nb[1];
+            pages[n_pages++] = addr / page_size;
+            const uintptr_t last = (addr + 89) / page_size;
+            if (last != addr / page_size) {
+                pages[n_pages++] = last;
+            }
+        }
+        qsort(pages, n_pages, sizeof(uint64_t), ggml_m5_lookup_compare_u64);
+        size_t unique_pages = 0;
+        for (size_t i = 0; i < n_pages; ++i) {
+            if (!i || pages[i] != pages[i-1]) {
+                ++unique_pages;
+            }
+        }
+        n_pages = unique_pages;
+    }
+    // Samples are intentionally bounded across the first four operations per pool.
+    char samples[1024] = "";
+    size_t used = 0;
+    if (metadata_ok && ordinal < 4) {
+        const int64_t n_samples = MIN(counted, 4);
+        for (int64_t i = 0; i < n_samples; ++i) {
+            used += (size_t) snprintf(samples + used, sizeof(samples) - used,
+                "%s{\"row\":%" PRIu64 ",\"address\":\"%p\",\"tensor_offset\":%" PRIu64 "}",
+                i ? "," : "", rows[i], (const void *) ((const char *) src->data + rows[i]*src->nb[1]), rows[i]*src->nb[1]);
+        }
+    }
+    fprintf(stderr, "M5_LOOKUP_OP {\"pool\":\"%p\",\"ordinal\":%" PRIu64
+        ",\"begin_us\":%" PRId64 ",\"end_us\":%" PRId64 ",\"envelope_us\":%" PRId64
+        ",\"worker_sum_us\":%" PRId64 ",\"threads\":%d,\"rows\":%" PRId64
+        ",\"unique_rows\":%zu,\"logical_bytes\":%zu,\"pages\":%zu,\"page_bytes\":%zu"
+        ",\"page_size\":%zu,\"metadata_rows\":%" PRId64 ",\"metadata_complete\":%s"
+        ",\"tensor_address\":\"%p\",\"demand_samples\":[%s]}\n",
+        (void *) tp, ordinal, begin, end, end - begin, sum, nth, nr,
+        n_unique, n_unique * 90, n_pages, n_pages * page_size, page_size,
+        metadata_ok ? counted : 0, metadata_ok && nr <= cap ? "true" : "false",
+        src->data, samples);
+    free(pages);
+    free(rows);
+}
