+int ggml_metal_m5_lab_int(const char * name, int fallback, int minimum, int maximum) {
+    const char * value = std::getenv(name);
+    if (!value) {
+        return fallback;
+    }
+    char * end = nullptr;
+    const long result = std::strtol(value, &end, 10);
+    GGML_ASSERT(end != value && *end == '\0' && result >= minimum && result <= maximum);
