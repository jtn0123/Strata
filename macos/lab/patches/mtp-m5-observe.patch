+// Call only after the graph completes. This is a lab-only dispatch receipt.
+static int ggml_backend_metal_m5_top10_status(const ggml_tensor * tensor) {
+    if (!tensor || !ggml_metal_m5_top10_eligible(tensor) || !tensor->buffer ||
+            !ggml_backend_buffer_is_metal(tensor->buffer) ||
+            ggml_metal_m5_lab_int("GGML_M5_LAB_TOP10", 0, 0, 1) != 1) {
+        return -1;
+    }
+    auto ctx = (ggml_metal_buffer_t) tensor->buffer->context;
+    if (!ggml_metal_buffer_is_shared(ctx)) {
+        return -1;
+    }
+    const auto * props = ggml_metal_device_get_props((ggml_metal_device_t) tensor->buffer->buft->device->context);
+    if (props->device_id != GGML_METAL_DEVICE_M5_PRO) {
+        return -1;
+    }
+    const size_t extra = ggml_metal_m5_top10_extra_bytes(tensor);
+    const size_t offset = 2*sizeof(int32_t)*248320 + extra - 16;
+    const uintptr_t base = (uintptr_t) ggml_backend_buffer_get_base(tensor->buffer);
+    const uintptr_t data = (uintptr_t) tensor->data;
+    const size_t size = ggml_backend_buffer_get_size(tensor->buffer);
+    if (data < base || data - base > size || offset + sizeof(uint32_t) > size - (data - base)) {
+        return -1;
+    }
+    uint32_t flag = 0;
+    ggml_metal_buffer_get_tensor(ctx, tensor, &flag, offset, sizeof(flag));
+    return flag <= 1 ? int(flag) : -1;
