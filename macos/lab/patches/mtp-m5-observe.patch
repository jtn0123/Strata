+// Integer keys preserve finite numeric order. Exceptional values use the old path.
+static inline uint m5_top10_key(uint bits) {
+    if ((bits & 0x7FFFFFFFu) == 0u) {
+        return 0x80000000u;
+    }
+    return (bits & 0x80000000u) ? ~bits : (bits | 0x80000000u);
+}
+
+kernel void kernel_m5_top10_blocks(
+        constant int & n,
+        device const uint * src,
+        device uint4 * parts,
+        uint group [[threadgroup_position_in_grid]],
+        uint lane [[thread_index_in_threadgroup]],
+        uint simd_lane [[thread_index_in_simdgroup]],
+        uint simd_id [[simdgroup_index_in_threadgroup]]) {
+    threadgroup uint4 partial[8];
+    threadgroup uint4 best;
+    uint keys[4];
+    uint invalid = 0;
+    for (uint j = 0; j < 4; ++j) {
+        uint index = group*1024 + j*256 + lane;
+        uint bits = index < uint(n) ? src[index] : 0;
+        uint exponent = bits & 0x7F800000u;
+        bool exceptional = exponent == 0x7F800000u || (exponent == 0 && (bits & 0x007FFFFFu) != 0);
+        invalid |= index < uint(n) && exceptional;
+        keys[j] = index < uint(n) && !exceptional ? m5_top10_key(bits) : 0;
+    }
+    for (uint rank = 0; rank < 10; ++rank) {
+        uint key = max(max(keys[0], keys[1]), max(keys[2], keys[3]));
+        uint simd_key = simd_max(key);
+        uint count = 0;
+        uint index = 0xFFFFFFFFu;
+        for (uint j = 0; j < 4; ++j) {
+            if (keys[j] != 0 && keys[j] == simd_key) {
+                ++count;
+                index = min(index, group*1024 + j*256 + lane);
+            }
+        }
+        uint sum = simd_sum(count);
+        uint first = simd_min(index);
+        uint bad = simd_max(invalid);
+        if (simd_lane == 0) {
+            partial[simd_id] = uint4(simd_key, first, sum, bad);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (lane == 0) {
+            best = uint4(0, 0xFFFFFFFFu, 0, 0);
+            for (uint i = 0; i < 8; ++i) {
+                uint4 v = partial[i];
+                best.w |= v.w;
+                if (v.x > best.x) {
+                    best.xyz = v.xyz;
+                } else if (v.x != 0 && v.x == best.x) {
+                    best.y = min(best.y, v.y);
+                    best.z += v.z;
+                }
+            }
+            parts[group*10 + rank] = best;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (uint j = 0; j < 4; ++j) {
+            if (keys[j] == best.x) {
+                keys[j] = 0;
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+}
+
+kernel void kernel_m5_top10_finish(
+        constant int & n_parts,
+        device const uint4 * parts,
+        device uint * fast_flag,
+        device int * dst,
+        uint lane [[thread_index_in_threadgroup]],
+        uint simd_lane [[thread_index_in_simdgroup]],
+        uint simd_id [[simdgroup_index_in_threadgroup]]) {
+    threadgroup uint4 partial[8];
+    threadgroup uint4 best;
+    threadgroup uint limit;
+    threadgroup uint fast;
+    if (lane == 0) {
+        limit = 0xFFFFFFFFu;
+        fast = 1;
+        fast_flag[0] = 0;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint rank = 0; rank < 10; ++rank) {
+        uint key = 0;
+        uint invalid = 0;
+        for (uint i = lane; i < uint(n_parts); i += 256) {
+            uint4 v = parts[i];
+            invalid |= v.w;
+            if (v.x < limit) {
+                key = max(key, v.x);
+            }
+        }
+        uint simd_key = simd_max(key);
+        uint count = 0;
+        uint index = 0xFFFFFFFFu;
+        for (uint i = lane; i < uint(n_parts); i += 256) {
+            uint4 v = parts[i];
+            if (v.x != 0 && v.x == simd_key) {
+                count += v.z;
+                index = min(index, v.y);
+            }
+        }
+        uint sum = simd_sum(count);
+        uint first = simd_min(index);
+        uint bad = simd_max(invalid);
+        if (simd_lane == 0) {
+            partial[simd_id] = uint4(simd_key, first, sum, bad);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (lane == 0) {
+            best = uint4(0, 0xFFFFFFFFu, 0, 0);
+            for (uint i = 0; i < 8; ++i) {
+                uint4 v = partial[i];
+                best.w |= v.w;
+                if (v.x > best.x) {
+                    best.xyz = v.xyz;
+                } else if (v.x != 0 && v.x == best.x) {
+                    best.y = min(best.y, v.y);
+                    best.z += v.z;
+                }
+            }
+            fast &= best.x != 0 && best.z == 1 && best.w == 0;
+            dst[rank] = best.x != 0 ? int(best.y) : 0;
+            limit = best.x;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (lane == 0) {
+        fast_flag[0] = fast;
+    }
+}
