+                (unsigned long long) call, role, tokens, seqs, outputs, reason,
+                (long long) begin, (long long) end, (long long) clock_low,
+                (long long) clock_high, mach_us, rows.c_str());
+    }
+};
+struct m5_observe_span {
+    m5_observe_call & c;
