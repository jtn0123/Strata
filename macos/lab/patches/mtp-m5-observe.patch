+    GGML_ASSERT(ggml_metal_pipeline_max_theads_per_threadgroup(finish) >= 256);
+    ggml_metal_encoder_set_pipeline(ctx->enc, blocks);
+    ggml_metal_encoder_set_bytes(ctx->enc, &n, sizeof(n), 0);
+    ggml_metal_encoder_set_buffer(ctx->enc, src, 1);
+    ggml_metal_encoder_set_buffer(ctx->enc, parts, 2);
+    ggml_metal_encoder_dispatch_threadgroups(ctx->enc, groups, 1, 1, 256, 1, 1);
