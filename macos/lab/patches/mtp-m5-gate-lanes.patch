+// Single assignment, separate stored gate/up weights, original Q2_0 bit sums and F32 SwiGLU.
+template<int nr0>
+kernel void kernel_m5_gate_up_q2_0_f32(
+        constant ggml_metal_kargs_mul_mv_id & args,
+        device const char * gate,
+        device const char * up,
+        device const char * src1,
+        device const char * ids,
+        device float * dst,
+        uint3 tgpig [[threadgroup_position_in_grid]],
+        ushort tiisg [[thread_index_in_simdgroup]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    const int token = tgpig.z/args.nei0;
+    const int slot = tgpig.z%args.nei0;
+    const int expert = ((device const int32_t *) (ids + token*args.nbi1))[slot];
+    const int first_row = (tgpig.x*N_SG_Q2_0 + sgitg)*nr0;
+    const uint dst_offset = tgpig.z*args.ne0;
+    if (expert < 0 || expert >= args.ne02) {
+        if (tiisg == 0) {
+            for (int row = 0; row < nr0 && first_row + row < args.ne01; ++row) {
+                dst[dst_offset + first_row + row] = as_type<float>(0x7fc00000u);
+            }
+        }
+        return;
+    }
+    device const float * y = (device const float *) (src1 + token*args.nb12);
+    device const block_q2_0 * ax[2][nr0];
+    FOR_UNROLL (int row = 0; row < nr0; ++row) {
+        const uint64_t offset = expert*args.nb02 + (first_row + row)*args.nb01;
+        ax[0][row] = (device const block_q2_0 *) (gate + offset);
+        ax[1][row] = (device const block_q2_0 *) (up + offset);
+    }
+    float yl[16];
+    float sumf[2][nr0] = {};
+    const short ix = tiisg/4;
+    const short il = (tiisg%4)*16;
+    device const float * yb = y + ix*QK2_0 + il;
+    for (int ib = ix; ib < args.ne00/QK2_0; ib += N_SIMDWIDTH/4) {
+        float sumy = 0.f;
+        FOR_UNROLL (short i = 0; i < 16; ++i) {
+            yl[i] = yb[i];
+            sumy += yb[i];
+        }
+        FOR_UNROLL (short row = 0; row < nr0; ++row) {
+            FOR_UNROLL (short projection = 0; projection < 2; ++projection) {
+                sumf[projection][row] += block_q_n_dot_y(ax[projection][row] + ib, sumy, yl, il);
+            }
+        }
+        yb += QK2_0*(N_SIMDWIDTH/4);
+    }
+    float lane_x0 = 0.f;
+    float lane_x1 = 0.f;
+    for (int row = 0; row < nr0; ++row) {
+        // Keep both reductions uniform and in their original order; each output
+        // lane retains one row so the identical SwiGLU epilogue runs in parallel.
+        const float x0 = simd_sum(sumf[0][row]);
+        const float x1 = simd_sum(sumf[1][row]);
+        if (tiisg == row) {
+            lane_x0 = x0;
+            lane_x1 = x1;
+        }
+    }
+    if (tiisg < nr0 && first_row + tiisg < args.ne01) {
+        const float silu = lane_x0/(1.0f + exp(-lane_x0));
+        dst[dst_offset + first_row + tiisg] = silu*lane_x1;
+    }
+}
