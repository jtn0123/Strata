+// Gate/up are siblings, so validate the complete branch instead of the linear-chain rule.
+static bool ggml_metal_fusion_check_m5_gate_up(
+        const ggml_metal_fusion * fusion,
+        const ggml_tensor * const * nodes,
+        const ggml_cgraph * gf,
+        const int * node_idxs,
+        int idx,
+        ggml_metal_fusion_mode mode) {
+    static const int enabled = ggml_metal_m5_lab_int("GGML_M5_LAB_GATE_UP", 0, 0, 2);
+    if (!enabled || node_idxs[idx + 1] != node_idxs[idx] + 1 || node_idxs[idx + 2] != node_idxs[idx] + 2) {
+        return false;
+    }
+    // Allocation dependency matching uses this exact raw three-node span.
+    const ggml_tensor * a = nodes[0];
+    const ggml_tensor * b = nodes[1];
+    const ggml_tensor * glu = nodes[2];
+    if (a == b || glu->src[0] == glu->src[1] ||
+        !((glu->src[0] == a && glu->src[1] == b) || (glu->src[0] == b && glu->src[1] == a)) ||
+        ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || ggml_get_op_params_i32(glu, 1) != 0 ||
+        glu->type != GGML_TYPE_F32 || glu->view_src || !ggml_is_contiguous(glu)) {
+        return false;
+    }
+    const ggml_tensor * x = a->src[1];
+    const ggml_tensor * ids = a->src[2];
+    if (!x || !ids || b->src[1] != x || b->src[2] != ids ||
+        x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) ||
+        x->ne[0] != 2560 || x->ne[1] != 1 || x->ne[3] != 1 ||
+        ids->type != GGML_TYPE_I32 || ids->ne[0] != 10 || ids->ne[1] != x->ne[2] ||
+        ids->ne[2] != 1 || ids->ne[3] != 1 || ids->nb[0] != sizeof(int32_t) ||
+        ids->nb[1] < 10*sizeof(int32_t) || ids->nb[1] % sizeof(int32_t) != 0 ||
+        glu->ne[0] != 640 || glu->ne[1] != 10 || glu->ne[2] != x->ne[2] || glu->ne[3] != 1) {
+        return false;
+    }
+    for (int i = 0; i < 2; ++i) {
+        const ggml_tensor * mm = nodes[i];
+        const ggml_tensor * w = mm->src[0];
+        if (!w || w->type != GGML_TYPE_Q2_0 || !ggml_is_contiguous(w) ||
+            w->ne[0] != 2560 || w->ne[1] != 640 || w->ne[2] != 512 || w->ne[3] != 1 ||
+            mm->type != GGML_TYPE_F32 || mm->view_src || !ggml_is_contiguous(mm) ||
+            !ggml_are_same_shape(mm, glu)) {
+            return false;
+        }
+    }
+    // Keep the same packing for different ubatch lengths; only R4/R5 execute this kernel.
+    if (mode == GGML_METAL_FUSION_FULL && x->ne[2] != 4 && x->ne[2] != 5) {
+        return false;
+    }
+    const int output = node_idxs[idx + 2];
+    if (!ggml_can_fuse_subgraph_ext(gf, node_idxs + idx, 3, fusion->ops.data(), &output, 1)) {
+        return false;
+    }
+    if (mode == GGML_METAL_FUSION_FULL) {
+        // Include leaf tensors: generic fusion range checks may skip GGML_OP_NONE inputs.
+        const ggml_tensor * external[] = { a->src[0], b->src[0], x, ids };
+        if (!glu->data || !glu->buffer) {
+            return false;
+        }
+        for (const ggml_tensor * t : external) {
+            if (!t->data || !(t->view_src ? t->view_src->buffer : t->buffer) || ggml_metal_fusion_overlap(glu, t)) {
+                return false;
+            }
+        }
+    }
+    static const int trace = ggml_metal_m5_lab_int("GGML_M5_LAB_GATE_TRACE", 0, 0, 1);
+    if (trace && mode == GGML_METAL_FUSION_STRUCTURAL) {
+        fprintf(stderr, "M5_GATE_ROUTE {\"phase\":\"structural\",\"k\":2560,\"m\":640,\"rows\":%lld,\"tile\":%d,\"first_index\":%d,\"glu_index\":%d,\"gate_first\":%s}\n",
+                (long long) x->ne[2], enabled == 1 ? 8 : 4, node_idxs[idx], output, glu->src[0] == a ? "true" : "false");
+    }
+    return true;
+}
