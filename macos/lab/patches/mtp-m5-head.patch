+        tensors += ",\"ne\":[";
+        for(int i=0;i<4;++i) { if(i) tensors+=','; tensors+=std::to_string(t->ne[i]); }
+        tensors += "],\"nb\":[";
+        for(int i=0;i<4;++i) { if(i) tensors+=','; tensors+=std::to_string(t->nb[i]); }
