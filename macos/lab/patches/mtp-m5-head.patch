+    tensors += ']';
+    fprintf(stderr,"M5_HEAD_DISPATCH {\"requested_nr0\":%d,\"eligible\":%s,\"kernel\":%s,\"pipeline_key\":%s,\"nr0\":%d,\"nsg\":%d,\"tensors\":%s}\n",
