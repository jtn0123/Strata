+static std::string m5_head_json_string(const char * s) {
+    std::string result = "\"";
+    for (const unsigned char * p = (const unsigned char *) s; *p; ++p) {
+        if (*p == '"' || *p == '\\') result += '\\';
+        if (*p >= 32) result += char(*p);
+        else { char escaped[7]; snprintf(escaped,sizeof(escaped),"\\u%04x",unsigned(*p)); result += escaped; }
+    }
+    return result + '"';
+}
