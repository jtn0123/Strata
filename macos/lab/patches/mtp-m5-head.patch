+        x->type != GGML_TYPE_F32 || op->type != GGML_TYPE_F32 ||
+        std::strcmp(w->name, "output.weight") || std::strcmp(op->name, "result_output")) return false;
+    if (w->ne[0] != 2560 || w->ne[1] != 248320 || x->ne[0] != 2560 || x->ne[1] != 1 ||
+        op->ne[0] != 248320 || op->ne[1] != 1) return false;
+    for (int i = 2; i < 4; ++i) if (w->ne[i] != 1 || x->ne[i] != 1 || op->ne[i] != 1) return false;
+    const size_t wn[] = {176,1760,437043200,437043200};
+    const size_t xn[] = {4,10240,10240,10240};
+    const size_t yn[] = {4,993280,993280,993280};
+    for (int i = 0; i < 4; ++i) if (w->nb[i] != wn[i] || x->nb[i] != xn[i] || op->nb[i] != yn[i]) return false;
+    // Dense zero-offset activation views are valid; offset/weight/output views
+    // and misaligned buffers conservatively retain their original dispatch.
+    return !w->view_src && !op->view_src && x->view_offs == 0 &&
+        w->data && x->data && op->data &&
