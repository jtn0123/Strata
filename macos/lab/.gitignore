# No trailing slash: also ignore local symlinks to these directories.
/.venv
/vendor
/models

# Raw measurements, process snapshots, runtime state and private notes stay local.
/bench/results
/bench/features
/bench/data
/bench/diagnostics
/bench/logs
/bench/local-pr-backups
/bench/private
/bench/research/**/*.json
/bench/research/**/source
/bench/research/**/source-before
/bench/research/**/source-after
/bench/research/**/*-source
*.stdout
*.jsonl

# Weights, serialized arrays and compiled local engines.
*.gguf
*.ggml
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.tflite
*.mlmodel
*.mlpackage
*.bin
*.npy
*.npz
*.dylib
*.a
*.o
*.so

# Private local settings and credentials; sample templates may be shared.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
credentials.json
secrets.json

bench/logs/
bench/runtime/
bench/.lock
bench/build*.log
bench/*-download.log
bench/*-manifest.json
bench/provision-verify.log
__pycache__/
*.pyc
.DS_Store
