diff --git a/ggml/src/ggml-metal/kernels/quantize.metal b/ggml/src/ggml-metal/kernels/quantize.metal
index 73679b9..b0c27ee 100644
--- a/ggml/src/ggml-metal/kernels/quantize.metal
+++ b/ggml/src/ggml-metal/kernels/quantize.metal
@@ -2,6 +2,35 @@
 #include "dequantize.h"
 #include "quantize.h"
 
+template<int V>
+kernel void kernel_cpy_rows_f32(
+        constant ggml_metal_kargs_cpy & args,
+        device const char * src0,
+        device char * dst,
+        uint3 group [[threadgroup_position_in_grid]],
+        uint3 lane [[thread_position_in_threadgroup]],
+        uint3 ntg [[threads_per_threadgroup]]) {
+    const uint row = group.y % args.ne01;
+    const uint plane = group.y / args.ne01;
+    const uint x = (group.x * ntg.x + lane.x) * V;
+    if (x >= args.ne00) return;
+    device const uint * s = (device const uint *)(src0 + row*args.nb01 + plane*args.nb02 + group.z*args.nb03) + x;
+    device uint * d = (device uint *)(dst + row*args.nb1 + plane*args.nb2 + group.z*args.nb3) + x;
+    if (V == 1) {
+        d[0] = s[0];
+    } else if (x + V <= args.ne00) {
+        ((device uint4 *)d)[0] = ((device const uint4 *)s)[0];
+        if (V == 8) ((device uint4 *)d)[1] = ((device const uint4 *)s)[1];
+    } else {
+        for (uint i = 0; i < V && x+i < args.ne00; ++i) d[i] = s[i];
+    }
+}
+
+typedef decltype(kernel_cpy_rows_f32<1>) kernel_cpy_rows_t;
+template [[host_name("kernel_cpy_rows_f32_1")]] kernel kernel_cpy_rows_t kernel_cpy_rows_f32<1>;
+template [[host_name("kernel_cpy_rows_f32_4")]] kernel kernel_cpy_rows_t kernel_cpy_rows_f32<4>;
+template [[host_name("kernel_cpy_rows_f32_8")]] kernel kernel_cpy_rows_t kernel_cpy_rows_f32<8>;
+
 template<typename T0, typename T1>
 kernel void kernel_cpy_t_t(
         constant ggml_metal_kargs_cpy & args,
@@ -487,4 +516,3 @@ typedef decltype(kernel_set_rows_q<float, int64_t, QK_K, block_tq2_0, quantize_t
 
 template [[host_name("kernel_set_rows_f32_i64_tq2_0")]]  kernel set_rows_qK_t kernel_set_rows_q<float, int64_t, QK_K, block_tq2_0, quantize_tq2_0>;
 template [[host_name("kernel_set_rows_f32_i32_tq2_0")]]  kernel set_rows_qK_t kernel_set_rows_q<float, int32_t, QK_K, block_tq2_0, quantize_tq2_0>;
