  "title": "prefill: gate/up MMQ reads the experts in place (CUDA; patched copy of llama.cpp mmq.cuh)",
  "user": {
    "login": "xrip",
    "id": 420432,
    "node_id": "MDQ6VXNlcjQyMDQzMg==",
    "avatar_url": "https://avatars.githubusercontent.com/u/420432?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/xrip",
    "html_url": "https://github.com/xrip",
    "followers_url": "https://api.github.com/users/xrip/followers",
    "following_url": "https://api.github.com/users/xrip/following{/other_user}",
    "gists_url": "https://api.github.com/users/xrip/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/xrip/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/xrip/subscriptions",
    "organizations_url": "https://api.github.com/users/xrip/orgs",
    "repos_url": "https://api.github.com/users/xrip/repos",
    "events_url": "https://api.github.com/users/xrip/events{/privacy}",
