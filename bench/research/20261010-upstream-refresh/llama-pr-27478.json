  "title": "ggml : speed up batch-1 CPU decode, align large allocations",
  "user": {
    "login": "matevz-kovacic",
    "id": 117923752,
    "node_id": "U_kgDOBwdfqA",
    "avatar_url": "https://avatars.githubusercontent.com/u/117923752?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/matevz-kovacic",
    "html_url": "https://github.com/matevz-kovacic",
    "followers_url": "https://api.github.com/users/matevz-kovacic/followers",
    "following_url": "https://api.github.com/users/matevz-kovacic/following{/other_user}",
    "gists_url": "https://api.github.com/users/matevz-kovacic/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/matevz-kovacic/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/matevz-kovacic/subscriptions",
    "organizations_url": "https://api.github.com/users/matevz-kovacic/orgs",
    "repos_url": "https://api.github.com/users/matevz-kovacic/repos",
    "events_url": "https://api.github.com/users/matevz-kovacic/events{/privacy}",
    "received_events_url": "https://api.github.com/users/matevz-kovacic/received_events",
