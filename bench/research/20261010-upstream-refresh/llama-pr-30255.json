  "locked": false,
  "title": "llama : skip logits buffer allocation when graph produces no logits",
  "user": {
    "login": "animeshsri14",
    "id": 68246830,
    "node_id": "MDQ6VXNlcjY4MjQ2ODMw",
    "avatar_url": "https://avatars.githubusercontent.com/u/68246830?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/animeshsri14",
    "html_url": "https://github.com/animeshsri14",
    "followers_url": "https://api.github.com/users/animeshsri14/followers",
    "following_url": "https://api.github.com/users/animeshsri14/following{/other_user}",
    "gists_url": "https://api.github.com/users/animeshsri14/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/animeshsri14/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/animeshsri14/subscriptions",
    "organizations_url": "https://api.github.com/users/animeshsri14/orgs",
    "repos_url": "https://api.github.com/users/animeshsri14/repos",
    "events_url": "https://api.github.com/users/animeshsri14/events{/privacy}",
    "received_events_url": "https://api.github.com/users/animeshsri14/received_events",
