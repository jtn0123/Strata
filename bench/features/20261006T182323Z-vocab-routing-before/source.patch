+// meld-turbo: copy the rows of the draft vocabulary subset (raw int32 token ids)
+// out of the LM head the MTP head uses, into a small head of its own next to it
+void llama_context::init_draft_vocab(const char * path) {
+    std::ifstream f(path, std::ios::binary | std::ios::ate);
+    if (!f) {
+        throw std::runtime_error(format("cannot open draft vocabulary '%s'", path));
+    }
+    ggml_tensor * head = model.output;
+    if (!head || !head->buffer || !ggml_is_contiguous(head)) {
+        throw std::runtime_error("draft vocabulary: missing contiguous allocated output head");
+    }
+    const int64_t n_vocab = head->ne[1];
+    const auto length = f.tellg();
+    if (length <= 0 || length > n_vocab * (int64_t) sizeof(int32_t) || length % sizeof(int32_t) != 0) {
+        throw std::runtime_error("draft vocabulary: file must contain 1..n_vocab complete int32 token ids");
+    }
+    std::vector<int32_t> ids((size_t) length / sizeof(int32_t));
+    f.seekg(0);
+    if (!f.read(reinterpret_cast<char *>(ids.data()), length)) {
+        throw std::runtime_error("draft vocabulary: incomplete read");
+    }
+    std::vector<bool> seen(n_vocab, false);
+    for (int32_t t : ids) {
+        if (t < 0 || t >= n_vocab) {
+            throw std::runtime_error(format("draft vocabulary '%s': token id %d out of range", path, t));
+        }
+        if (seen[t]) {
+            throw std::runtime_error("draft vocabulary: duplicate token id");
+        }
+        seen[t] = true;
+    }
+    if ((int64_t) ids.size() == n_vocab) {
+        return;
+    }
+
+    ggml_init_params ip = { 2*ggml_tensor_overhead(), nullptr, true };
+    draft_vocab_ctx.reset(ggml_init(ip));
+    ggml_tensor * sub = ggml_new_tensor_2d(draft_vocab_ctx.get(), head->type, head->ne[0], (int64_t) ids.size());
+    ggml_tensor * tid = ggml_new_tensor_1d(draft_vocab_ctx.get(), GGML_TYPE_I32, (int64_t) ids.size());
+    ggml_set_name(sub, "draft_vocab_head");
+    ggml_set_name(tid, "draft_vocab_ids");
+    draft_vocab_buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(draft_vocab_ctx.get(), ggml_backend_buffer_get_type(head->buffer)));
+    if (!draft_vocab_buf) {
+        throw std::runtime_error("draft vocabulary: buffer allocation failed");
+    }
+
+    const size_t row = ggml_row_size(head->type, head->ne[0]);
+    std::vector<uint8_t> tmp(row*ids.size());
+    for (size_t i = 0; i < ids.size(); ++i) {
+        ggml_backend_tensor_get(head, tmp.data() + i*row, (size_t) ids[i]*row, row);
+    }
+    ggml_backend_tensor_set(sub, tmp.data(), 0, tmp.size());
+    ggml_backend_tensor_set(tid, ids.data(), 0, ids.size()*sizeof(int32_t));
+
+    cparams.draft_vocab_head = sub;
+    cparams.draft_vocab_ids  = tid;
+    LLAMA_LOG_INFO("%s: draft vocabulary: %zu of %lld tokens (%s, %.1f MiB) from '%s'\n", __func__,
+            ids.size(), (long long) n_vocab, ggml_type_name(head->type), tmp.size()/1048576.0, path);
+}
